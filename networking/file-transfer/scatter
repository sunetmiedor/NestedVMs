#check for missing args
if [[ $# -ne 2 ]]; then
    echo "Missing arguments: scatter <file> <destination_directory>"
    exit 1
fi

#discover and save child list
./discover-vms.sh > /tmp/child-tree.txt 
CHILD_TREE="/tmp/child-tree.txt"
FILE_TO_TRANSFER="$1"
DESTINATION_DIRECTORY="$2"

#traverse child list, copy file into desired directory
while read -r name ip; do
        scp "$FILE_TO_TRANSFER" "$USER@$ip:$DESTINATION_DIRECTORY"
    done < "$CHILD_TREE"