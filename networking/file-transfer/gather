#check for missing args
if [[ $# -ne 2 ]]; then
    echo "Missing arguments: gather <file> <destination_directory>"
    exit 1
fi

#discover and save child list
./discover-vms.sh > /tmp/child-tree.txt 
CHILD_TREE="/tmp/child-tree.txt"
FILE_TO_TRANSFER="$1"
DESTINATION_DIRECTORY="$2"

#traverse child list, copy file into desired directory with the name of the machine it was found on appeneded
while read -r name ip; do
        scp "$USER@$ip:$FILE_TO_TRANSFER" "$DESTINATION_DIRECTORY/$(basename "$FILE_TO_TRANSFER").$name"
    done < "$CHILD_TREE"